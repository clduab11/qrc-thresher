From a0ff6149ceca58442883d5e716ef99fdc6af4e8c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 24 Sep 2026 05:33:51 +0000
Subject: [PATCH] proof: an unreadable runs.csv fails the run on every platform
 (A3, Linux)

The Linux run of the CP4b.1 suite (third environment, after the Windows
sandbox and the Windows host) failed one test:
tests/test_cp4b1_integrity.py::TestRunsCsvFailuresAreLoud::
test_run_exits_one_and_leaves_no_row_anywhere. check_runs_csv_header
returned early when st_size == 0, which is what Windows reports for a
directory standing where runs.csv should be, so the failure surfaced
later inside the wrapped write as PermissionError and became the loud
RunsCsvWriteError. Linux reports 4096 for a directory, so the guard went
on to open() it, raised IsADirectoryError from ExperimentDB.insert (which
calls the guard outside the wrapped write), and the bare OSError escaped
run_handler instead of exit 1 with the path.

check_runs_csv_header now refuses a directory explicitly and wraps every
OSError it meets as RunsCsvWriteError naming the path, so both callers
(append_to_csv and ExperimentDB.insert) fail the same way on every
platform; the two callers re-raise a RunsCsvWriteError instead of
wrapping it twice. No test changes: the existing test is the one that
caught it. Linux: the A3 class, test_runs_csv_schema and test_proof_layer
pass (17 tests); the full suite result is in the CP4c go message.

Referee-authored (a Linux-only failure the Windows sandbox cannot
reproduce); recorded for the next DECISIONS entry.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/qrc_thresher/db.py                 |  4 ++--
 src/qrc_thresher/proof/run_manifest.py | 19 +++++++++++++++----
 2 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/src/qrc_thresher/db.py b/src/qrc_thresher/db.py
index c345502..a9870ab 100644
--- a/src/qrc_thresher/db.py
+++ b/src/qrc_thresher/db.py
@@ -168,8 +168,8 @@ class ExperimentDB:
         try:
             with filelock.FileLock(str(lock_path), timeout=30):
                 self._write_csv_row(manifest, csv_path)
-        except RunsCsvSchemaError:
-            raise
+        except (RunsCsvSchemaError, RunsCsvWriteError):
+            raise  # RunsCsvWriteError is already named by check_runs_csv_header
         except (OSError, filelock.Timeout) as exc:
             raise RunsCsvWriteError(csv_path, exc) from exc
 
diff --git a/src/qrc_thresher/proof/run_manifest.py b/src/qrc_thresher/proof/run_manifest.py
index db5c153..b02da41 100644
--- a/src/qrc_thresher/proof/run_manifest.py
+++ b/src/qrc_thresher/proof/run_manifest.py
@@ -106,11 +106,20 @@ def check_runs_csv_header(csv_path: Path) -> None:
 
     Raises:
         RunsCsvSchemaError: If the file's header differs from CSV_FIELDNAMES.
+        RunsCsvWriteError: If the path cannot be read as a file (a directory in its place, a
+            permission problem). Raised here, before any writer, so that every platform fails
+            the same way: Windows reports st_size 0 for a directory and Linux does not, which
+            is how this escaped as a bare IsADirectoryError on Linux (CP4b.1 item A3).
     """
-    if not csv_path.exists() or csv_path.stat().st_size == 0:
-        return
-    with csv_path.open(newline='') as f:
-        existing = next(csv.reader(f), [])
+    try:
+        if csv_path.is_dir():
+            raise IsADirectoryError(f'{csv_path.as_posix()} is a directory, not a file')
+        if not csv_path.exists() or csv_path.stat().st_size == 0:
+            return
+        with csv_path.open(newline='') as f:
+            existing = next(csv.reader(f), [])
+    except OSError as exc:
+        raise RunsCsvWriteError(csv_path, exc) from exc
     if existing == CSV_FIELDNAMES:
         return
     missing = [c for c in CSV_FIELDNAMES if c not in existing]
@@ -423,6 +432,8 @@ def append_to_csv(manifest: RunManifest, csv_path: Path = _RUNS_CSV) -> None:
             if write_header:
                 writer.writeheader()
             writer.writerow(row)
+    except RunsCsvWriteError:
+        raise  # already named by check_runs_csv_header; do not wrap it twice
     except OSError as exc:
         raise RunsCsvWriteError(csv_path, exc) from exc
 
